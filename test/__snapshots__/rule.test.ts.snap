// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`EcsFargateTaskTerminationDetectionEventRule snapshots should match the snapshot for ALL_FAILURES 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "Rule4C995B7F": {
      "Properties": {
        "EventPattern": {
          "detail": {
            "$or": [
              {
                "containers": {
                  "exitCode": [
                    {
                      "anything-but": 0,
                    },
                  ],
                },
                "stoppedReason": [
                  {
                    "anything-but": {
                      "prefix": [
                        "Scaling activity initiated by",
                        "Task stopped by user",
                        "Your Spot Task was interrupted",
                      ],
                    },
                  },
                ],
              },
              {
                "stopCode": [
                  "TaskFailedToStart",
                ],
              },
              {
                "stoppedReason": [
                  {
                    "prefix": "CannotPullContainerError",
                  },
                  {
                    "prefix": "ResourceInitializationError",
                  },
                ],
              },
            ],
            "clusterArn": [
              "arn:aws:ecs:us-east-1:123456789012:cluster/example-app-cluster",
            ],
            "lastStatus": [
              "STOPPED",
            ],
            "launchType": [
              "FARGATE",
            ],
          },
          "detail-type": [
            "ECS Task State Change",
          ],
          "source": [
            "aws.ecs",
          ],
        },
        "State": "ENABLED",
      },
      "Type": "AWS::Events::Rule",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
`;

